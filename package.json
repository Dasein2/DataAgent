{
  "name": "pi-database-analysis-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/*.test.ts\"",
    "smoke": "bash scripts/smoke-http.sh",
    "test:integration:local": "bash scripts/test-integration-local.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "express": "5.2.1",
    "mysql2": "3.15.3",
    "node-sql-parser": "5.3.13",
    "pg": "8.16.3",
    "pg-query-stream": "4.10.3",
    "ssh2": "1.17.0",
    "typebox": "1.3.27",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/ssh2": "1.15.5",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
