# ── Service ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_PORT=8787
# Legacy mode: required in production if account mode is off. Replace the placeholder.
DATA_AGENT_API_TOKEN=change-me
DATA_AGENT_DATA_DIR=./data
# Optional account login. In account mode bearer tokens and X-Caller-Id are ignored.
# DATA_AGENT_REQUIRE_AUTH=1
# Set only for the first startup to create admin (minimum 8 characters); remove after bootstrap.
# DATA_AGENT_ADMIN_PASSWORD=
# Secure cookies default to ON in production. Use HTTPS for remote access.
# DATA_AGENT_SECURE_AUTH_COOKIE=1
# Required in account mode (generate with openssl rand -hex 32); optional in legacy mode.
# Enables encrypted server-side storage of connection passwords / SSH credentials, and
# encrypts the model API keys saved from the console (data/model-key.json). Keep this key stable
# across restarts. Without it, profiles store connection settings only and console keys are kept as
# plain text in a 0600 file (same exposure as this one).
# DATA_AGENT_PROFILE_SECRET_KEY=

# ── Sessions & budgets ─────────────────────────────────────────────────────────
DATA_AGENT_SESSION_TTL_MS=3600000
DATA_AGENT_MAX_SESSIONS=20
# Self-hosted databases are usually on a private network; set to false for strict egress.
DATA_AGENT_ALLOW_PRIVATE_NETWORK=true
# Express `trust proxy`. Leave UNSET unless every client reaches this service through your own
# reverse proxy. Setting it while the port is also reachable directly lets a client forge
# X-Forwarded-For and reset the per-IP login rate limit. Values: 1 (trust exactly one proxy hop),
# loopback, 10.0.0.0/8; `true` trusts every hop and is only safe when the port is loopback-only.
# With it set, bind the published port to 127.0.0.1.
# DATA_AGENT_TRUST_PROXY=1
DATA_AGENT_MAX_TURNS=40
DATA_AGENT_MAX_QUERIES=60
DATA_AGENT_TASK_TIMEOUT_MS=900000
# Auto fallback for PostgreSQL/MySQL when the server has no timeout / cannot be probed.
# Doris/StarRocks fall back to 300000 ms. Connections may set queryTimeoutMs explicitly.
DATA_AGENT_QUERY_TIMEOUT_MS=60000
# Hard ceiling for ALL connections, including manual settings; task timeout also applies.
DATA_AGENT_MAX_QUERY_TIMEOUT_MS=600000
DATA_AGENT_MAX_RESULT_ROWS=1000000
DATA_AGENT_PREVIEW_ROWS=30
DATA_AGENT_CELL_CHARS=200
DATA_AGENT_MAX_RESULT_BYTES=536870912
DATA_AGENT_MAX_DATASETS=50
# Chart artifacts. The chart layer never aggregates, so the row cap is a spec-quality guard:
# a result bigger than this must be GROUP BY-ed in SQL before it can be charted.
DATA_AGENT_MAX_CHART_ROWS=20000
DATA_AGENT_MAX_CHART_CELLS=3600
DATA_AGENT_MAX_ARTIFACTS_PER_TASK=12
# 业务资料预算。These documents are appended to the system prompt on EVERY model turn, so one task
# pays document_tokens x turns in input tokens. 10k/30k keep a single document and a whole selection
# inside a 128k window with room for tool results; raising them multiplies per-task cost and latency.
# Estimates count roughly one token per CJK character and four characters per token otherwise.
DATA_AGENT_BUSINESS_DOCUMENT_TOKENS=10000
DATA_AGENT_BUSINESS_SELECTION_TOKENS=30000
DATA_AGENT_BUSINESS_DOCUMENT_CHARS=40000

# ── Read-only BI workbench ─────────────────────────────────────────────────────
# One source SQL connection remains serialized; metadata uses independently verified connections.
# Each live session can hold 1 source + up to 4 metadata connections (plus control/SSH connections).
DATA_AGENT_METADATA_CONCURRENCY=2
DATA_AGENT_METADATA_TTL_MS=300000
# Result reuse is opt-in per query (reuse=true), exact SQL + row cap, session/identity scoped.
# Set cache TTLs to 0 to disable. Original execution time and cache age are disclosed.
DATA_AGENT_RESULT_CACHE_TTL_MS=60000
# off | warn | enforce. EXPLAIN consumes query budget. LIMIT does not cap source scans.
# enforce rejects unsupported/unknown estimates; EXPLAIN estimates are NOT a hard scan limit.
DATA_AGENT_PREFLIGHT=warn
DATA_AGENT_MAX_ESTIMATED_SCAN_ROWS=5000000
DATA_AGENT_MAX_ESTIMATED_COST=1000000
# Local SQL reads saved rows only, never extracts another source snapshot.
DATA_AGENT_MAX_LOCAL_ROWS=100000
DATA_AGENT_MAX_LOCAL_BYTES=67108864
DATA_AGENT_MAX_SESSION_BYTES=1073741824
DATA_AGENT_MAX_CHART_SERIES=30
# 0 disables retention. Defaults to 30 days when NODE_ENV=production (unbounded evidence growth is a
# production outage) and to 0 in development. Purging removes sessions, results, artifacts, snapshots
# and conversation files older than this; audit ndjson files are NOT purged and need their own rotation.
DATA_AGENT_RETENTION_DAYS=30
# Exact output-column names only (case-insensitive). Not source authorization; aliases can evade it.
# Prefer database grants/RLS/approved views. deny produces NULL, partial reveals ends, hash is session-salted.
# DATA_AGENT_COLUMN_MASKS=[{"column":"phone","mode":"partial"},{"column":"email","mode":"hash"}]

# ── Production sizing ─────────────────────────────────────────────────────────
# The defaults above are generous for one operator and too generous for a shared server: 20 sessions x
# 512 MB results x 1 GB held bytes can exhaust memory or the data volume. This project is
# single-instance by design (SQLite account store, in-memory sessions, one data volume); scale up, not out.
# Suggested starting point for 4 vCPU / 8 GB RAM:
#   DATA_AGENT_MAX_SESSIONS=8
#   DATA_AGENT_MAX_RESULT_BYTES=134217728     # 128 MB
#   DATA_AGENT_MAX_SESSION_BYTES=268435456    # 256 MB
#   DATA_AGENT_MAX_RESULT_ROWS=200000
#   DATA_AGENT_MAX_LOCAL_ROWS=50000
#   DATA_AGENT_MAX_LOCAL_BYTES=33554432       # 32 MB
# Budget: one live session can hold 1 source + 4 metadata connections, so MAX_SESSIONS=8 needs the
# source database to accept ~40 connections from this service.

# ── Independent model management ──────────────────────────────────────────────
# Configure project-owned channels from the web console; no personal pi directory is needed.
# Server deployment: set NODE_ENV=production, account login or a strong token, and PROFILE_SECRET_KEY.
# DATA_AGENT_ALLOW_MODEL_EDIT=1
# DATA_AGENT_PI_IMPORT=0
# See docs/model-management.md. Channel definitions: data/model-providers.json;
# encrypted keys/private headers: data/model-provider-secrets.json.
# External pi import defaults to ON in development and OFF in production.
# DATA_AGENT_MODEL_* deliberately avoids PI_*, which the pi harness itself exports.
# Leave provider/model/thinking unset to follow pi's settings.json (defaultProvider, defaultModel,
# defaultThinkingLevel) and use that channel's key from models.json. Set them to pin a channel.
# DATA_AGENT_MODEL_PROVIDER=openai
# DATA_AGENT_MODEL_ID=gpt-5.2
# DATA_AGENT_MODEL_API_KEY=
# Custom endpoint (optional). One of the protocols pi-ai speaks:
#   openai-completions   (wide gateway compatibility: DeepSeek, Moonshot, Qwen, Ollama, vLLM, one-api)
#   openai-responses     (OpenAI Responses API: native reasoning items)
#   anthropic-messages   (Claude, or an Anthropic-compatible gateway)
#   google-generative-ai (Gemini generateContent)
# A protocol needs a base URL: on its own it describes nothing, so the service refuses it. Leave both
# unset to keep the provider's built-in endpoint and protocol.
# DATA_AGENT_MODEL_BASE_URL=https://api.example.com/v1
# DATA_AGENT_MODEL_API=openai-completions
# DATA_AGENT_MODEL_HEADERS={"X-Org":"analytics"}
# Only needed when pi's catalogue does not already know the model, or to clamp it:
# DATA_AGENT_MODEL_CONTEXT_WINDOW=128000
# DATA_AGENT_MODEL_MAX_TOKENS=16384
# off|minimal|low|medium|high|xhigh|max. A level above off declares reasoning support; set
# DATA_AGENT_MODEL_REASONING=0 when the model rejects reasoning parameters (use off instead for
# endpoints that have no reasoning support at all). xhigh/max are only served by some model families.
# DATA_AGENT_MODEL_THINKING=medium
# DATA_AGENT_MODEL_REASONING=env   (env = follow the thinking level; 1 = on; 0 = off)
# Allow the console (PUT /v1/model) to override the settings above at runtime. Defaults to on in
# development and off when NODE_ENV=production, because changing base-url redirects every answer.
# DATA_AGENT_ALLOW_MODEL_EDIT=1
# Reuse an existing pi credential store instead of exporting a key:
# DATA_AGENT_MODEL_AUTH_PATH=C:/Users/<you>/.pi/agent/auth.json
# Load a different config file (also available as: node dist/server.js --env-file .env.prod):
# DATA_AGENT_ENV_FILE=.env.prod
