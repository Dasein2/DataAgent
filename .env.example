# ── Service ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_PORT=8787
# Required when NODE_ENV=production. Clients send `Authorization: Bearer <token>`.
DATA_AGENT_API_TOKEN=change-me
DATA_AGENT_DATA_DIR=./data
# Optional: enables encrypted server-side storage of connection passwords / SSH credentials, and
# encrypts the model API keys saved from the console (data/model-key.json). Keep this key stable
# across restarts. Without it, profiles store connection settings only and console keys are kept as
# plain text in a 0600 file (same exposure as this one).
# DATA_AGENT_PROFILE_SECRET_KEY=

# ── Sessions & budgets ─────────────────────────────────────────────────────────
DATA_AGENT_SESSION_TTL_MS=3600000
DATA_AGENT_MAX_SESSIONS=20
# Self-hosted databases are usually on a private network; set to false for strict egress.
DATA_AGENT_ALLOW_PRIVATE_NETWORK=true
DATA_AGENT_MAX_TURNS=40
DATA_AGENT_MAX_QUERIES=60
DATA_AGENT_TASK_TIMEOUT_MS=900000
DATA_AGENT_QUERY_TIMEOUT_MS=60000
DATA_AGENT_MAX_RESULT_ROWS=1000000
DATA_AGENT_PREVIEW_ROWS=30
DATA_AGENT_CELL_CHARS=200
DATA_AGENT_MAX_RESULT_BYTES=536870912
DATA_AGENT_MAX_DATASETS=50
# Chart artifacts. The chart layer never aggregates, so the row cap is a spec-quality guard:
# a result bigger than this must be GROUP BY-ed in SQL before it can be charted.
DATA_AGENT_MAX_CHART_ROWS=20000
DATA_AGENT_MAX_CHART_CELLS=3600
DATA_AGENT_MAX_ARTIFACTS_PER_TASK=12

# ── Independent model management ──────────────────────────────────────────────
# Configure project-owned channels from the web console; no personal pi directory is needed.
# Server deployment: set NODE_ENV=production, a strong token + PROFILE_SECRET_KEY above, then:
# DATA_AGENT_ALLOW_MODEL_EDIT=1
# DATA_AGENT_PI_IMPORT=0
# See docs/model-management.md. Channel definitions: data/model-providers.json;
# encrypted keys/private headers: data/model-provider-secrets.json.
# External pi import defaults to ON in development and OFF in production.
# DATA_AGENT_MODEL_* deliberately avoids PI_*, which the pi harness itself exports.
# Leave provider/model/thinking unset to follow pi's settings.json (defaultProvider, defaultModel,
# defaultThinkingLevel) and use that channel's key from models.json. Set them to pin a channel.
# DATA_AGENT_MODEL_PROVIDER=openai
# DATA_AGENT_MODEL_ID=gpt-5.2
# DATA_AGENT_MODEL_API_KEY=
# Custom endpoint (optional). One of the protocols pi-ai speaks:
#   openai-completions   (wide gateway compatibility: DeepSeek, Moonshot, Qwen, Ollama, vLLM, one-api)
#   openai-responses     (OpenAI Responses API: native reasoning items)
#   anthropic-messages   (Claude, or an Anthropic-compatible gateway)
#   google-generative-ai (Gemini generateContent)
# A protocol needs a base URL: on its own it describes nothing, so the service refuses it. Leave both
# unset to keep the provider's built-in endpoint and protocol.
# DATA_AGENT_MODEL_BASE_URL=https://api.example.com/v1
# DATA_AGENT_MODEL_API=openai-completions
# DATA_AGENT_MODEL_HEADERS={"X-Org":"analytics"}
# Only needed when pi's catalogue does not already know the model, or to clamp it:
# DATA_AGENT_MODEL_CONTEXT_WINDOW=128000
# DATA_AGENT_MODEL_MAX_TOKENS=16384
# off|minimal|low|medium|high|xhigh|max. A level above off declares reasoning support; set
# DATA_AGENT_MODEL_REASONING=0 when the model rejects reasoning parameters (use off instead for
# endpoints that have no reasoning support at all). xhigh/max are only served by some model families.
# DATA_AGENT_MODEL_THINKING=medium
# DATA_AGENT_MODEL_REASONING=env   (env = follow the thinking level; 1 = on; 0 = off)
# Allow the console (PUT /v1/model) to override the settings above at runtime. Defaults to on in
# development and off when NODE_ENV=production, because changing base-url redirects every answer.
# DATA_AGENT_ALLOW_MODEL_EDIT=1
# Reuse an existing pi credential store instead of exporting a key:
# DATA_AGENT_MODEL_AUTH_PATH=C:/Users/<you>/.pi/agent/auth.json
# Load a different config file (also available as: node dist/server.js --env-file .env.prod):
# DATA_AGENT_ENV_FILE=.env.prod
