# ── Service ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_PORT=8787
# Required when NODE_ENV=production. Clients send `Authorization: Bearer <token>`.
DATA_AGENT_API_TOKEN=change-me
DATA_AGENT_DATA_DIR=./data
# Optional: enables encrypted server-side storage of connection passwords / SSH credentials.
# Keep this key stable across restarts. Without it, profiles store connection settings only.
# DATA_AGENT_PROFILE_SECRET_KEY=

# ── Sessions & budgets ─────────────────────────────────────────────────────────
DATA_AGENT_SESSION_TTL_MS=3600000
DATA_AGENT_MAX_SESSIONS=20
# Self-hosted databases are usually on a private network; set to false for strict egress.
DATA_AGENT_ALLOW_PRIVATE_NETWORK=true
DATA_AGENT_MAX_TURNS=40
DATA_AGENT_MAX_QUERIES=60
DATA_AGENT_TASK_TIMEOUT_MS=900000
DATA_AGENT_QUERY_TIMEOUT_MS=60000
DATA_AGENT_MAX_RESULT_ROWS=1000000
DATA_AGENT_PREVIEW_ROWS=30
DATA_AGENT_CELL_CHARS=200
DATA_AGENT_MAX_RESULT_BYTES=536870912
DATA_AGENT_MAX_DATASETS=50

# ── Model (pi) ────────────────────────────────────────────────────────────────
# DATA_AGENT_MODEL_* deliberately avoids PI_*, which the pi harness itself exports.
DATA_AGENT_MODEL_PROVIDER=openai
DATA_AGENT_MODEL_ID=gpt-5.2
DATA_AGENT_MODEL_API_KEY=
# Custom OpenAI-compatible endpoint (optional):
# DATA_AGENT_MODEL_BASE_URL=https://api.example.com/v1
# DATA_AGENT_MODEL_API=openai-completions
# DATA_AGENT_MODEL_HEADERS={"X-Org":"analytics"}
# DATA_AGENT_MODEL_CONTEXT_WINDOW=128000
# DATA_AGENT_MODEL_MAX_TOKENS=16384
# off|minimal|low|medium|high. Use off for custom endpoints without reasoning support.
# DATA_AGENT_MODEL_THINKING=medium
# Reuse an existing pi credential store instead of exporting a key:
# DATA_AGENT_MODEL_AUTH_PATH=C:/Users/<you>/.pi/agent/auth.json
# Load a different config file (also available as: node dist/server.js --env-file .env.prod):
# DATA_AGENT_ENV_FILE=.env.prod
